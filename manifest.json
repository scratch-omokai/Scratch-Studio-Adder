{
  "manifest_version": 3,
  "name": "Scratch 作品一括追加/削除",
  "version": "1.0.0",
  "description": "1つのScratch作品を、複数のスタジオにクールタイム付きでまとめて追加/削除します。",
  "permissions": ["sidePanel", "scripting", "storage"],
  "host_permissions": ["https://scratch.mit.edu/*"],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "スタジオ一括操作を開く",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
